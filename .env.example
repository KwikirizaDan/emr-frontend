# Server-side only. Do NOT prefix these with NEXT_PUBLIC_, otherwise they are
# inlined into the browser bundle.

# Base URL of the existing Flask JSON API.
FLASK_API_BASE_URL=http://localhost:5000

# Secret used to derive the AES-256-GCM key that encrypts the session cookie.
# Generate one with: openssl rand -base64 32
# In development a fallback is used so the app can start without it.
SESSION_SECRET=

# Optional public display name, only if a browser-visible name is required.
# NEXT_PUBLIC_APP_NAME=Meru EMR
